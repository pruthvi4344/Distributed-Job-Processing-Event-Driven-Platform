# Base URL of the FlowGrid FastAPI backend.
# - Used at BUILD time by Vite (`npm run dev` / `npm run build`) via import.meta.env.VITE_API_BASE_URL.
# - In the Docker/nginx production image this is instead read at CONTAINER START time by
#   docker-entrypoint.sh, which writes it into /usr/share/nginx/html/env-config.js as
#   window.__FLOWGRID_API_BASE__ — that value takes precedence over the build-time one.
# Falls back to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000
